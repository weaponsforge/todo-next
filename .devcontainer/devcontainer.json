{
  "name": "Todo App DevContainer",
  "dockerComposeFile": ["../docker-compose.dev.yml"],
  "service": "todo-client-dev",  // VS Code attaches here
  "workspaceFolder": "/opt/app", // Monorepo root
  "runServices": ["todo-client-dev", "todo-server-dev", "mongo"],
  "postCreateCommand": "chmod +x .devcontainer/setup.sh && .devcontainer/setup.sh",
  "forwardPorts": [3000, 3001, 27017, 9229],
  "extensions": ["esbenp.prettier-vscode", "dbaeumer.vscode-eslint"]
}
